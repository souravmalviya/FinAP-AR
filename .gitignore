# --- dependencies & build output (nested .gitignores also cover these) ---
node_modules/
dist/
.next/

# --- secrets: NEVER commit env files (API keys, passwords) ---
.env
.env.*
!.env.example

# --- runtime data (uploaded PDFs, generated demo invoices) ---
storage/
samples/

# --- internal design/engineering docs (kept local, not published) ---
docs/

# --- OS / editor junk ---
.DS_Store
Thumbs.db
*.log

# --- TypeScript incremental build cache (regenerated on every build) ---
*.tsbuildinfo

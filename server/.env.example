# Copy to ".env" and adjust.

# The product's OWN database (separate from the ERP's database!)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/finerp_ap?schema=public"

# Port this pipeline API listens on (ERP uses 4000, web will use 3000)
PORT=5000

# Where the Mini-ERP (system of record) is running
ERP_BASE_URL="http://localhost:4000"

# Where uploaded PDFs are kept when S3 is NOT configured. Relative to server/.
STORAGE_DIR="./storage"

# --- AWS S3 storage (optional) ----------------------------------------------
# If S3_BUCKET is set, invoice PDFs are stored in S3 instead of STORAGE_DIR.
# Setup (free tier friendly):
#   1. AWS console -> S3 -> Create bucket (unique name, Block Public Access ON)
#   2. IAM -> create user (no console access) -> attach a policy that allows
#      s3:PutObject + s3:GetObject on arn:aws:s3:::YOUR_BUCKET/* only
#   3. Create an access key for that user and paste all four values below
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are the AWS SDK's own standard
# variable names - the SDK reads them from the environment automatically.
# S3_ENDPOINT is only for S3-compatible services (e.g. Cloudflare R2);
# leave empty for real AWS.
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: if set, invoice extraction uses Claude instead of the mock parser.
ANTHROPIC_API_KEY=

# Optional: OpenRouter (openrouter.ai) - one key, many models. Used when no
# Anthropic key is set. Pick the model with OPENROUTER_MODEL.
# Check current slugs at openrouter.ai/models - they rotate over time. e.g.:
#   anthropic/claude-haiku-4.5   (cheap, excellent at extraction - default)
#   anthropic/claude-3-haiku     (cheapest)
#   openai/gpt-4o-mini           (cheap alternative)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Valkey (open-source Redis fork) - job queue broker. Run it via:
#   docker compose up -d   (from the finErpAP folder)
VALKEY_HOST=localhost
VALKEY_PORT=6379

# --- Security (all optional - sensible defaults apply) ------------------------
# Browser origin allowed to call this API. "*" for local dev; in production
# set the exact dashboard URL, e.g. https://verity.vercel.app
CORS_ORIGIN=*
# Max invoice PDF size in MB (enforced on uploads AND email attachments)
UPLOAD_MAX_MB=10
# Login/register: per-IP limit (RATE_AUTH_MAX tries per window)
RATE_AUTH_WINDOW_MIN=15
RATE_AUTH_MAX=20
# Authenticated API: per-user limit (keyed by user id, not IP)
RATE_USER_WINDOW_MIN=1
RATE_USER_MAX=240
# Failed-login backoff per account: first FREE_FAILS are free, then the wait
# doubles each failure (BASE * 2^n) capped at MAX. No hard lockout.
LOGIN_BACKOFF_FREE_FAILS=3
LOGIN_BACKOFF_BASE_SECONDS=2
LOGIN_BACKOFF_MAX_SECONDS=300
# Queue dashboard (/admin/queues): set BOTH to require browser basic auth.
# If unset, the dashboard is open in dev and disabled in production.
BULLBOARD_USER=
BULLBOARD_PASSWORD=

# --- Gmail email ingestion (optional) ---------------------------------------
# Uses IMAP + a Google "App Password" (NOT your normal password).
# Setup (use a TEST Gmail account, not your personal one):
#   1. myaccount.google.com → Security → turn ON 2-Step Verification
#   2. myaccount.google.com/apppasswords → create one (name: finErpAP)
#   3. paste the 16-character password below (spaces are ok - stripped)
# When both are set, the server polls the inbox for PDF attachments.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_POLL_SECONDS=60
GMAIL_ORG_ID=org_demo
